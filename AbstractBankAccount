
abstract class BankAccount {
    private String accountNumber;
    protected double balance;

    BankAccount(String accountNumber, double balance) {
        this.accountNumber = accountNumber;
        this.balance = balance;
    }

    abstract void withdraw(double amount);

    void deposit(double amount) {
        if (amount <= 0) {
            refuse("deposit must be more than 0");
        } else {
            balance += amount;
        }
    }

    void refuse(String why) {
        System.out.println(accountNumber + " refused: " + why);
    }

    void show() {
        System.out.println(accountNumber + " balance: " + balance);
    }
}

class SavingsAccount extends BankAccount {
    SavingsAccount(String n, double b) {
        super(n, b);
    }

    @Override
    void withdraw(double amount) {
        if (amount <= 0) {
            refuse("amount must be more than 0");
        } else if (balance - amount < 50) {
            refuse("must keep at least 50");
        } else {
            balance -= amount;
        }
    }
}

class CurrentAccount extends BankAccount {
    CurrentAccount(String n, double b) {
        super(n, b);
    }

    @Override
    void withdraw(double amount) {
        if (amount <= 0) {
            refuse("amount must be more than 0");
        } else if (balance - amount < -200) {
            refuse("overdraft limit is 200");
        } else {
            balance -= amount;
        }
    }
}

class StudentAccount extends BankAccount {
    StudentAccount(String n, double b) {
        super(n, b);
    }

    @Override
    void withdraw(double amount) {
        if (amount <= 0) {
            refuse("amount must be more than 0");
        } else if (amount > 100) {
            refuse("max 100 per withdrawal");
        } else if (amount > balance) {
            refuse("not enough money");
        } else {
            balance -= amount;
        }
    }
    public class Abstract {
        public static void main(String[] args) {
            BankAccount acc1 = new SavingsAccount("SAV-1", 200);
            BankAccount acc2 = new CurrentAccount("CUR-1", 200);
            BankAccount acc3 = new StudentAccount("STU-1", 200);

            System.out.println("Savings Account:");
            acc1.deposit(50);
            acc1.withdraw(300);
            acc1.show();

            System.out.println("\nCurrent Account:");
            acc2.deposit(50);
            acc2.withdraw(300);
            acc2.show();

            System.out.println("\nStudent Account:");
            acc3.deposit(50);
            acc3.withdraw(300);
            acc3.show();
        }
    }

}
